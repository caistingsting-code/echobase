rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: cards
    // Document ID: auto-generated
    // Fields:
    //   - id: string (required) - unique ID for the card
    //   - uid: string (required) - owner's user ID
    //   - title: string (required) - title of the card
    //   - content: string (required) - full content of the note or link
    //   - tags: list (optional) - list of tags
    //   - source: string (optional) - source URL or origin
    //   - created_at: number (required) - timestamp of creation
    //   - updated_at: number (required) - timestamp of last update
    //   - links: list (optional) - IDs of linked cards
    //   - summary: string (optional) - AI-generated summary
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "caistingsting@gmail.com" && request.auth.token.email_verified == true));
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidCard(data) {
      return hasRequiredFields(['uid', 'title', 'content', 'created_at', 'updated_at']) &&
             hasOnlyAllowedFields(['uid', 'title', 'content', 'tags', 'source', 'created_at', 'updated_at', 'links', 'summary']) &&
             data.uid is string &&
             data.title is string && data.title.size() < 200 &&
             data.content is string && data.content.size() < 100000 &&
             data.created_at is number &&
             data.updated_at is number &&
             (!('tags' in data) || data.tags is list) &&
             (!('source' in data) || data.source is string) &&
             (!('links' in data) || data.links is list) &&
             (!('summary' in data) || data.summary is string);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /cards/{cardId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidCard(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidCard(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner() || isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && request.resource.data.role == 'user';
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
    }
  }
}
